{
  "name": "alice",
  "version": "0.1.0",
  "private": true,
  "description": "Alice: a live video AI stylist. Built at the Gemini 4 NYC Hackathon on 2026-11-21.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "postinstall": "node scripts/vendor.mjs",
    "test": "node --test tests/",
    "start": "node server.ts",
    "serve": "node --watch server.ts",
    "dev": "python3 -m http.server 5173 --directory public",
    "calllog": "node scripts/calllog.ts",
    "agent": "node --env-file-if-exists=.env.local src/agent/worker.ts dev",
    "agent:start": "node --env-file-if-exists=.env.local src/agent/worker.ts start",
    "cert": "node scripts/make-cert.mjs",
    "start:lan": "HOST=0.0.0.0 PORT=3443 ALICE_TLS_CERT=data/certs/alice.crt ALICE_TLS_KEY=data/certs/alice.key node server.ts",
    "drill": "node scripts/store-drill.ts",
    "warm": "node scripts/store-warm.ts",
    "bag:matrix": "node scripts/bag-matrix.ts",
    "cost": "node scripts/cost.ts",
    "media:check": "node scripts/media-check.ts",
    "rehearsal": "node --env-file-if-exists=.env.local scripts/backend-rehearsal.ts"
  },
  "dependencies": {
    "@google/genai": "3.6.1",
    "@livekit/agents": "1.10.1",
    "@livekit/agents-plugin-google": "1.10.1",
    "@livekit/noise-cancellation-node": "0.3.1",
    "@livekit/rtc-node": "1.2.3",
    "jpeg-js": "0.4.4",
    "livekit-client": "2.25.0",
    "livekit-server-sdk": "2.20.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  }
}
