# Alice: environment template.
# Copy to .env.local and fill in the values:   cp .env.example .env.local
# .env.local is gitignored. Never commit real keys.

# --- Google (use the one paid project key for both) ---
GOOGLE_API_KEY=
GOOGLE_TRYON_API_KEY=
# "paid" runs Gemini Live on the paid key too
ALICE_LIVE_KEY=paid

# --- LiveKit (your OWN project while developing; one worker per project) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Worker dispatch name; the token endpoint dispatches to this name
ALICE_AGENT_NAME=alice

# --- Tavus face ---
# Tavus API key (required when AVATAR=tavus)
TAVUS_API_KEY=
# Tavus replica / face id (required when AVATAR=tavus)
TAVUS_FACE_ID=
# Optional Tavus persona / PAL id; leave empty to use the plugin's default echo-mode LiveKit persona
TAVUS_PERSONA_ID=
# tavus | none. Develop with "none"; only the demo machine turns the face on
AVATAR=none

# --- Voice and vision ---
GEMINI=google
# Aoede or Achernar (confirm on the day)
GEMINI_VOICE=
# on | off
VISION=on
# Camera frame interval in ms
VISION_FRAME_MS=1000
# Enhanced noise cancellation on shopper audio: bvc (default) | nc | off
ALICE_NOISE_CANCEL=bvc
# Room acoustics preset for Gemini Live speech detection: noisy (default) | quiet
ALICE_ROOM=noisy
# Optional Gemini Live VAD overrides (empty = use ALICE_ROOM preset)
# ALICE_VAD_START=low | high
ALICE_VAD_START=
# ALICE_VAD_END=low | high
ALICE_VAD_END=
ALICE_VAD_SILENCE_MS=
ALICE_VAD_PREFIX_MS=

# --- Call page ---
# Set whenever the page is reachable from outside this machine
ALICE_PASSCODE=
# Public URL (tunnel) checklist:
# - Set ALICE_PASSCODE to at least 12 characters (e.g. four random words); share in the link fragment: https://<host>/#k=<passcode>
# - Set ALICE_TRUST_PROXY=1 (only when behind a local tunnel/proxy such as cloudflared or ngrok)
# - Optional: set ALICE_MAX_CALLS_PER_HOUR=<n> to cap total calls minted per hour
# - Keep HOST=127.0.0.1 (do not bind 0.0.0.0 behind a local tunnel)
# ALICE_TRUST_PROXY=1
# ALICE_MAX_CALLS_PER_HOUR=
# ALICE_MAX_ACTIVE_CALLS=1   # one call at a time (default when AVATAR=tavus): a second caller is asked to stand by

# --- Shopper accounts (added after the hackathon; off unless switched on) ---
# on | off. When on, the page gets a Sign in button and Alice remembers a signed-in
# shopper's name, department, sizes and notes between calls.
ALICE_ACCOUNTS=off
# The SQLite file that holds accounts (email, password hash), sessions and memory.
# Default: data/alice.db. On a server, point this at a disk that survives a redeploy.
# ALICE_DB_PATH=
# Most accounts the server will create (default 5000)
# ALICE_ACCOUNTS_MAX=
# on | off. Adds "Sign in with Shop" to the account panel (needs ALICE_ACCOUNTS=on).
# It uses Shop's public prototype client; Shop's docs say an app that is distributed
# needs its own registered client, so leave this off outside a prototype.
ALICE_ACCOUNTS_SHOP=off

# --- Models (leave as is unless swapping a model) ---
ALICE_MODEL_LIVE=gemini-3.8-live
ALICE_MODEL_STYLIST=gemini-4-hydrogen
ALICE_MODEL_FAST=gemini-3.5-flash-lite
ALICE_MODEL_GATE=gemini-decision-1
ALICE_MODEL_TRYON=gemini-nano-banana-2.1

# --- Outfit builder ---
# Set to "fast" to plan with Flash Lite; empty = Hydrogen
ALICE_LIVE_PLANNER=
# ms before the Flash Lite hedge plan starts
ALICE_PLAN_HEDGE_MS=8000
ALICE_PLAN_THINKING=LOW
ALICE_PICK_THINKING=LOW
# on | off (off forces live builds)
ALICE_LIBRARY=on
ALICE_LIBRARY_ATTEMPTS=2
# Spend cap in USD per library build run
ALICE_LIBRARY_MAX_PAID=5.5
# on | off (off skips the second search over the non-Fashion-Nova stores)
ALICE_MIXED_SEARCH=on
# on | off (off sends store images to try-on)
ALICE_CLEAN_SHOTS=on
