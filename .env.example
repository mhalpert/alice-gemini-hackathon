# Alice: environment template.
# Copy to .env.local and fill in the values:   cp .env.example .env.local
# .env.local is gitignored. Never commit real keys.

# --- Google (use the one paid project key for both) ---
GOOGLE_API_KEY=
GOOGLE_TRYON_API_KEY=
# "paid" runs Gemini Live on the paid key too
ALICE_LIVE_KEY=paid

# --- LiveKit (your OWN project while developing; one worker per project) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Worker dispatch name; the token endpoint dispatches to this name
ALICE_AGENT_NAME=alice

# --- Tavus face ---
TAVUS_API_KEY=
TAVUS_FACE_ID=
# tavus | none. Develop with "none"; only the demo machine turns the face on
AVATAR=none

# --- Voice and vision ---
GEMINI=google
# Aoede or Achernar (confirm on the day)
GEMINI_VOICE=
# on | off
VISION=on
# Camera frame interval in ms
VISION_FRAME_MS=1000

# --- Call page ---
# Set whenever the page is reachable from outside this machine
ALICE_PASSCODE=

# --- Models (leave as is unless swapping a model) ---
ALICE_MODEL_LIVE=gemini-3.8-live
ALICE_MODEL_STYLIST=gemini-4-hydrogen
ALICE_MODEL_FAST=gemini-3.5-flash-lite
ALICE_MODEL_GATE=gemini-decision-1
ALICE_MODEL_TRYON=gemini-nano-banana-2.1

# --- Outfit builder ---
# Set to "fast" to plan with Flash Lite; empty = Hydrogen
ALICE_LIVE_PLANNER=
# ms before the Flash Lite hedge plan starts
ALICE_PLAN_HEDGE_MS=8000
ALICE_PLAN_THINKING=LOW
ALICE_PICK_THINKING=LOW
# on | off (off forces live builds)
ALICE_LIBRARY=on
ALICE_LIBRARY_ATTEMPTS=2
# Spend cap in USD per library build run
ALICE_LIBRARY_MAX_PAID=5.5
# on | off (off skips the second search over the non-Fashion-Nova stores)
ALICE_MIXED_SEARCH=on
# on | off (off sends store images to try-on)
ALICE_CLEAN_SHOTS=on
